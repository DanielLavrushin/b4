[Unit]
Description=b4 community hub
Documentation=https://github.com/daniellavrushin/b4
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=b4hub
Group=b4hub
WorkingDirectory=/var/lib/b4hub
EnvironmentFile=-/etc/b4hub/env
Environment=B4HUB_DATA=/var/lib/b4hub
Environment=B4HUB_LISTEN=127.0.0.1:7100
Environment=B4HUB_PUBLIC_URL=https://hub.b4core.app
ExecStart=/usr/local/bin/b4hub serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM

StateDirectory=b4hub
StateDirectoryMode=0750
ConfigurationDirectory=b4hub
ConfigurationDirectoryMode=0750
UMask=0027

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/b4hub

[Install]
WantedBy=multi-user.target
