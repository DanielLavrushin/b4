{
  "tool": "zapret",
  "label": "zapret (nfqws)",
  "style": "long_only",
  "homepage": "https://github.com/bol-van/zapret",
  "defaults": {
    "fake_ttl": 7,
    "fake_ttl_forced": false
  },
  "normalize": "zapret",
  "profile_model": "alternative",
  "detect": {
    "markers": [
      "nfqws",
      "winws",
      "zapret"
    ],
    "signature": [
      "--dpi-desync",
      "--new",
      "--qnum",
      "--hostlist",
      "--hostlist-domains",
      "--filter-tcp",
      "--filter-udp",
      "--dpi-desync-split-pos"
    ],
    "reject": [
      "--disoob",
      "--tlsrec",
      "--oob-data",
      "--fake-sni",
      "--mod-http"
    ]
  },
  "sources": {
    "vars": [
      "NFQWS_OPT",
      "NFQWS2_OPT",
      "NFQWS_ARGS",
      "NFQWS_ARGS_QUIC",
      "NFQWS_ARGS_UDP",
      "NFQWS_EXTRA_ARGS",
      "NFQWS_ARGS_IPSET",
      "NFQWS_ARGS_CUSTOM",
      "WINWS_OPT",
      "DVTWS_OPT",
      "NFQWS_OPT_DESYNC",
      "ARGS"
    ],
    "foreign": [
      "TPWS_OPT",
      "TPWS_SOCKS_OPT",
      "TPWS_ARGS",
      "TPWS_OPT_BASE",
      "TPWS_OPT_SOCKS"
    ],
    "placeholders": {
      "<HOSTLIST>": "--hostlist=zapret-hosts-user.txt",
      "<HOSTLIST_NOAUTO>": "--hostlist=zapret-hosts-user.txt",
      "^": ""
    },
    "layouts": [
      {
        "id": "nfqws-keenetic",
        "require": [
          "NFQWS_ARGS"
        ],
        "groups": [
          {
            "vars": [
              "NFQWS_ARGS_CUSTOM"
            ]
          },
          {
            "vars": [
              "NFQWS_ARGS_UDP"
            ]
          },
          {
            "vars": [
              "NFQWS_ARGS_QUIC",
              "NFQWS_ARGS_IPSET"
            ],
            "require": [
              "NFQWS_ARGS_QUIC",
              "NFQWS_ARGS_IPSET"
            ]
          },
          {
            "vars": [
              "NFQWS_ARGS_QUIC",
              "NFQWS_EXTRA_ARGS"
            ]
          },
          {
            "vars": [
              "NFQWS_ARGS",
              "NFQWS_ARGS_IPSET"
            ],
            "require": [
              "NFQWS_ARGS_IPSET"
            ]
          },
          {
            "vars": [
              "NFQWS_ARGS",
              "NFQWS_EXTRA_ARGS"
            ]
          }
        ]
      }
    ]
  },
  "versions": [
    {
      "id": "master",
      "label": "current",
      "default": true
    }
  ],
  "profile_break": [
    "new"
  ],
  "options": [
    {
      "key": "new",
      "long": "new",
      "arg": "none",
      "scope": "break",
      "target": "trigger"
    },
    {
